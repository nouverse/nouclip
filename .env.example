# ===================================================================
# NouClip Environment Configuration
# Put this in your working directory (.env) or globally in ~/.nouclip/.env
# ===================================================================

# 1. Voice Compute / OpenAI-Compatible Whisper STT Server
# Can point to local Voice Compute (https://github.com/nouverse/voice-compute) or any cloud Whisper API (e.g. OpenAI, Groq)
NOUCLIP_VOICE_COMPUTE_URL=http://localhost:8880
NOUCLIP_VOICE_COMPUTE_API_KEY= # Leave empty if running local Voice Compute

# 2. LLM OpenAI-Compatible Endpoint (for viral highlight detection)
# Works with OpenAI, Groq, OpenRouter, Ollama (http://localhost:11434/v1), etc.
NOUCLIP_OPENAI_BASE_URL=https://api.openai.com/v1
NOUCLIP_OPENAI_API_KEY=
NOUCLIP_OPENAI_MODEL=gpt-4o-mini

# 3. Custom Executable Paths (Optional - defaults to system PATH)
# NOUCLIP_FFMPEG_PATH=/usr/bin/ffmpeg
# NOUCLIP_FFPROBE_PATH=/usr/bin/ffprobe
# NOUCLIP_YTDLP_PATH=/usr/bin/yt-dlp
